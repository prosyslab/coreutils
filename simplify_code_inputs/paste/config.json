{
  "utility": "paste",
  "snapshot": "../..",
  "edition": "2024",
  "root": "paste.rs",
  "io_adaptation": "Ghost state follows I/O calls; owned file readers are explicitly closed and stdout capture is initialized.",
  "sources": [
    "paste.rs"
  ],
  "runtime": {
    "trusted_common": "common.rs",
    "paste_trusted": "paste.rs"
  },
  "source_overrides": {
    "mod.rs": "io_wrapped/mod.rs",
    "runtime/paste.rs": "io_wrapped/runtime/paste.rs"
  },
  "modes": {
    "parallel": "!args.serial",
    "serial": "args.serial"
  },
  "included": [
    "default parallel",
    "-s",
    "-d delimiter cycling and escapes",
    "-z",
    "shared stdin (-)",
    "file inputs"
  ],
  "excluded": [
    "CLI help/version",
    "failed I/O",
    "invalid delimiter syntax",
    "non-C locales",
    "non-Linux platforms"
  ],
  "trusted": "../common/capture.rs"
}
