{
  "utility": "sort",
  "snapshot": "../..",
  "edition": "2024",
  "root": "sort.rs",
  "io_adaptation": "Ghost state follows I/O calls; initial stdout is combined with captured writes.",
  "generated_apis": {
    "crate::original::chunks::Chunk": {
      "crate": "self_cell",
      "macro": "self_cell",
      "owner": "Chunk",
      "file": "original/chunks.rs",
      "reference": "original/chunks.rs",
      "methods": [
        "new", "try_new", "try_new_or_recover",
        "borrow_owner", "borrow_dependent",
        "with_dependent", "with_dependent_mut", "into_owner"
      ]
    }
  },
  "sources": [
    "sort.rs",
    "buffer_hint.rs",
    "check.rs",
    "chunks.rs",
    "custom_str_cmp.rs",
    "diagnostics.rs",
    "ext_sort/mod.rs",
    "ext_sort/threaded.rs",
    "ext_sort/wasi.rs",
    "merge.rs",
    "numeric_str_cmp.rs",
    "tmp_dir.rs"
  ],
  "runtime": {
    "trusted_common": "common.rs",
    "trusted": "sort.rs",
    "proof": "sort_callbacks.rs"
  },
  "source_overrides": {
    "mod.rs": "io_wrapped/mod.rs",
    "ext_sort/threaded.rs": "io_wrapped/ext_sort/threaded.rs",
    "merge.rs": "io_wrapped/merge.rs",
    "runtime/sort.rs": "io_wrapped/runtime/sort.rs"
  },
  "modes": {
    "full": "true"
  },
  "included": [
    "default",
    "-n",
    "-h",
    "-g",
    "-M",
    "-b",
    "-f",
    "-d",
    "-i",
    "-r",
    "-u",
    "-z",
    "-k",
    "-t separator",
    "file inputs",
    "shared stdin (-)"
  ],
  "excluded": [
    "-R/--random-sort (global and key-local)",
    "-V/--version-sort (global and key-local)",
    "-s/--stable",
    "-m",
    "-c/-C",
    "--debug",
    "CLI help/version",
    "resource/compression configuration",
    "failed I/O",
    "non-C locales",
    "non-Linux platforms"
  ],
  "trusted": "../common/proof.rs"
}
